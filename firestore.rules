rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isListMember(listData) {
      return isAuthenticated() && (
        listData.ownerId == request.auth.uid ||
        (listData.memberIds != null && request.auth.uid in listData.memberIds) ||
        (listData.familyCode != null && listData.familyCode != '')
      );
    }

    // 1. Family Rooms: Multi-tenant isolated pairing codes
    match /familyRooms/{roomCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.code == roomCode
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() 
        && (
          // Existing member updating room info
          request.auth.uid in resource.data.memberIds 
          // Or new member joining by adding themselves to memberIds
          || request.resource.data.memberIds.hasAll(resource.data.memberIds)
        );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 2. Grocery Lists: Multi-tenant isolated documents
    match /lists/{listId} {
      allow read: if isListMember(resource.data);
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        (request.resource.data.memberIds != null && request.auth.uid in request.resource.data.memberIds)
      );
      allow update: if isListMember(resource.data) || isListMember(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // 3. Isolated Items Subcollection: Prevents edit clobbering & minimizes bandwidth
      match /items/{itemId} {
        allow read, write: if isAuthenticated() && (
          isListMember(get(/databases/$(database)/documents/lists/$(listId)).data)
        );
      }
    }

    // 4. User Profiles & Friends
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 5. Friend Requests
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverContact == request.auth.token.email ||
        resource.data.receiverContact == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverContact == request.auth.token.email ||
        resource.data.receiverContact == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }
  }
}
